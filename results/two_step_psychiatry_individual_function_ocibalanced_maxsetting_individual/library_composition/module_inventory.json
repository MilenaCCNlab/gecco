{
  "modules": [
    {
      "id": "independent_betas",
      "name": "Independent MB/MF Betas",
      "description": "Uses separate inverse temperature parameters to independently scale model-based and model-free values, replacing the traditional shared beta and mixing weight.",
      "params": [
        {
          "name": "beta_mf",
          "bounds": [
            0,
            10
          ]
        }
      ],
      "slots": {},
      "overrides": {
        "stage1_values": "beta * np.array([0.7 * np.max(q_stage2_mf[0]) + 0.3 * np.max(q_stage2_mf[1]), 0.3 * np.max(q_stage2_mf[0]) + 0.7 * np.max(q_stage2_mf[1])]) + beta_mf * q_stage1_mf",
        "stage1_temp": "1.0",
        "stage2_temp": "beta_mf"
      },
      "provenance": [
        "1"
      ],
      "excludes": [
        "mb_mf_mixture",
        "outcome_dependent_temperature",
        "pure_model_free",
        "separate_stage_betas"
      ]
    },
    {
      "id": "choice_stickiness",
      "name": "Choice Stickiness",
      "description": "Adds a scalar bonus to the stage 1 logit of the action chosen on the previous trial to model perseveration.",
      "params": [
        {
          "name": "stickiness",
          "bounds": [
            0,
            5
          ]
        }
      ],
      "slots": {
        "init": "choice_stickiness_last_a1 = -1",
        "stage1_logits_extra": "if choice_stickiness_last_a1 != -1:\n    logits_1[choice_stickiness_last_a1] += stickiness",
        "post_trial": "if a1 != -1:\n    choice_stickiness_last_a1 = a1"
      },
      "overrides": {},
      "provenance": [
        "1",
        "2",
        "4",
        "6",
        "7",
        "8",
        "9",
        "10",
        "12"
      ],
      "excludes": [
        "reward_dependent_stickiness",
        "signed_choice_stickiness"
      ]
    },
    {
      "id": "signed_choice_stickiness",
      "name": "Signed Choice Stickiness",
      "description": "Adds a signed scalar bonus to the stage 1 logit of the action chosen on the previous trial to model perseveration or alternation.",
      "params": [
        {
          "name": "perseveration",
          "bounds": [
            -3,
            3
          ]
        }
      ],
      "slots": {
        "init": "signed_choice_stickiness_last_a1 = -1",
        "stage1_logits_extra": "if signed_choice_stickiness_last_a1 != -1:\n    logits_1[signed_choice_stickiness_last_a1] += perseveration",
        "post_trial": "if a1 != -1:\n    signed_choice_stickiness_last_a1 = a1"
      },
      "overrides": {},
      "provenance": [
        "13"
      ],
      "excludes": [
        "choice_stickiness",
        "reward_dependent_stickiness"
      ]
    },
    {
      "id": "direct_stage1_reward_update",
      "name": "Direct Stage 1 Reward Update",
      "description": "Updates the stage 1 model-free Q-value directly using the final reward, equivalent to an eligibility trace (lambda) of 1.",
      "params": [],
      "slots": {},
      "overrides": {
        "stage1_update": "q_stage1_mf[a1] += learning_rate * (r - q_stage1_mf[a1])"
      },
      "provenance": [
        "1",
        "2"
      ],
      "excludes": [
        "eligibility_trace",
        "stage2_first_update"
      ]
    },
    {
      "id": "unchosen_value_decay",
      "name": "Unchosen Value Decay",
      "description": "The values of all unchosen actions in both Stage 1 and Stage 2 decay towards zero at a constant rate.",
      "params": [
        {
          "name": "decay_rate",
          "bounds": [
            0,
            1
          ]
        }
      ],
      "slots": {
        "post_trial": "if a1 != -1:\n    q_stage1_mf[1 - a1] *= (1.0 - decay_rate)\nif s_idx != -1 and a2 != -1:\n    q_stage2_mf[s_idx, 1 - a2] *= (1.0 - decay_rate)\n    q_stage2_mf[1 - s_idx, :] *= (1.0 - decay_rate)"
      },
      "overrides": {},
      "provenance": [
        "2",
        "5",
        "6",
        "8",
        "9"
      ],
      "excludes": [
        "unchosen_value_decay_center",
        "stage2_value_decay_center",
        "stage2_unchosen_value_decay"
      ]
    },
    {
      "id": "q_init_05",
      "name": "Neutral Q-value Initialization",
      "description": "Stage 1 and Stage 2 model-free Q-values are initialized to a neutral value of 0.5 instead of 0.",
      "params": [],
      "slots": {
        "init": "q_stage1_mf = np.zeros(2) + 0.5"
      },
      "overrides": {
        "q2_init": "np.zeros((2, 2)) + 0.5"
      },
      "provenance": [
        "4",
        "13"
      ],
      "excludes": []
    },
    {
      "id": "stage2_value_decay_center",
      "name": "Stage 2 Value Decay to Center",
      "description": "Stage 2 Q-values decay towards a neutral center of 0.5 on every trial, representing forgetting or uncertainty.",
      "params": [
        {
          "name": "decay_rate_center",
          "bounds": [
            0,
            1
          ]
        }
      ],
      "slots": {
        "post_trial": "q_stage2_mf += decay_rate_center * (0.5 - q_stage2_mf)"
      },
      "overrides": {},
      "provenance": [
        "4"
      ],
      "excludes": [
        "unchosen_value_decay",
        "unchosen_value_decay_center",
        "stage2_unchosen_value_decay"
      ]
    },
    {
      "id": "mb_mf_mixture",
      "name": "MB/MF Mixture",
      "description": "Stage 1 action values are computed as a weighted mixture of model-based and model-free Q-values.",
      "params": [
        {
          "name": "w",
          "bounds": [
            0,
            1
          ]
        }
      ],
      "slots": {},
      "overrides": {
        "stage1_values": "w * np.array([0.7 * np.max(q_stage2_mf[0]) + 0.3 * np.max(q_stage2_mf[1]), 0.3 * np.max(q_stage2_mf[0]) + 0.7 * np.max(q_stage2_mf[1])]) + (1.0 - w) * q_stage1_mf"
      },
      "provenance": [
        "4",
        "7",
        "8",
        "9",
        "12"
      ],
      "excludes": [
        "independent_betas",
        "pure_model_free"
      ]
    },
    {
      "id": "counterfactual_updating",
      "name": "Counterfactual Updating",
      "description": "The Q-value of the unchosen Stage 2 action is updated using an assumed opposite reward.",
      "params": [
        {
          "name": "cf_weight",
          "bounds": [
            0,
            1
          ]
        }
      ],
      "slots": {
        "update_extra": "counterfactual_updating_cf_reward = 1.0 - r\ncounterfactual_updating_delta_cf = counterfactual_updating_cf_reward - q_stage2_mf[s_idx, 1 - a2]\nq_stage2_mf[s_idx, 1 - a2] += learning_rate * cf_weight * counterfactual_updating_delta_cf"
      },
      "overrides": {},
      "provenance": [
        "4",
        "7",
        "12"
      ],
      "excludes": []
    },
    {
      "id": "eligibility_trace",
      "name": "Eligibility Trace",
      "description": "Stage-1 action values are updated by the stage-2 reward prediction error scaled by an eligibility trace parameter.",
      "params": [
        {
          "name": "lambda_elig",
          "bounds": [
            0,
            1
          ]
        }
      ],
      "slots": {
        "update_extra": "q_stage1_mf[a1] += learning_rate * lambda_elig * delta_stage2"
      },
      "overrides": {},
      "provenance": [
        "5",
        "7",
        "8",
        "9",
        "10",
        "11",
        "12"
      ],
      "excludes": [
        "direct_stage1_reward_update",
        "stage2_first_update"
      ]
    },
    {
      "id": "separate_learning_rates",
      "name": "Separate Stage Learning Rates",
      "description": "Uses distinct learning rates for updating stage-1 and stage-2 Q-values rather than a single global learning rate.",
      "params": [
        {
          "name": "alpha_2",
          "bounds": [
            0,
            1
          ]
        }
      ],
      "slots": {
        "update_extra": "q_stage2_mf[s_idx, a2] += (alpha_2 - learning_rate) * delta_stage2"
      },
      "overrides": {},
      "provenance": [
        "6"
      ],
      "excludes": []
    },
    {
      "id": "unchosen_value_decay_center",
      "name": "Unchosen Value Decay to Center",
      "description": "Decays the Q-values of unchosen Stage 1 actions and unvisited Stage 2 states towards the neutral value of 0.5.",
      "params": [
        {
          "name": "decay_rate_center_unchosen",
          "bounds": [
            0,
            1
          ]
        }
      ],
      "slots": {
        "post_trial": "if a1 != -1:\n    q_stage1_mf[1 - a1] = (1.0 - decay_rate_center_unchosen) * q_stage1_mf[1 - a1] + decay_rate_center_unchosen * 0.5\nif s_idx != -1 and a2 != -1:\n    q_stage2_mf[s_idx, 1 - a2] = (1.0 - decay_rate_center_unchosen) * q_stage2_mf[s_idx, 1 - a2] + decay_rate_center_unchosen * 0.5\n    q_stage2_mf[1 - s_idx, :] = (1.0 - decay_rate_center_unchosen) * q_stage2_mf[1 - s_idx, :] + decay_rate_center_unchosen * 0.5"
      },
      "overrides": {},
      "provenance": [
        "7"
      ],
      "excludes": [
        "unchosen_value_decay",
        "stage2_value_decay_center",
        "stage2_unchosen_value_decay"
      ]
    },
    {
      "id": "reward_dependent_stickiness",
      "name": "Reward-Dependent Stickiness",
      "description": "Applies a stickiness bonus to the previously chosen actions in both stages, where the bonus magnitude depends on whether the previous trial resulted in a reward.",
      "params": [
        {
          "name": "stick_win",
          "bounds": [
            0,
            5
          ]
        },
        {
          "name": "stick_loss",
          "bounds": [
            0,
            5
          ]
        }
      ],
      "slots": {
        "init": "reward_dependent_stickiness_last_a1 = -1\nreward_dependent_stickiness_last_r = 0.0\nreward_dependent_stickiness_last_a2 = np.array([-1, -1])\nreward_dependent_stickiness_last_r2 = np.array([0.0, 0.0])",
        "stage1_logits_extra": "if reward_dependent_stickiness_last_a1 != -1:\n    logits_1[reward_dependent_stickiness_last_a1] += stick_win if reward_dependent_stickiness_last_r == 1.0 else stick_loss",
        "stage2_logits_extra": "if s_idx != -1 and reward_dependent_stickiness_last_a2[s_idx] != -1:\n    logits_2[reward_dependent_stickiness_last_a2[s_idx]] += stick_win if reward_dependent_stickiness_last_r2[s_idx] == 1.0 else stick_loss",
        "post_trial": "if a1 != -1:\n    reward_dependent_stickiness_last_a1 = a1\n    reward_dependent_stickiness_last_r = r\nif s_idx != -1 and a2 != -1:\n    reward_dependent_stickiness_last_a2[s_idx] = a2\n    reward_dependent_stickiness_last_r2[s_idx] = r"
      },
      "overrides": {},
      "provenance": [
        "11"
      ],
      "excludes": [
        "choice_stickiness",
        "signed_choice_stickiness"
      ]
    },
    {
      "id": "outcome_dependent_temperature",
      "name": "Outcome-Dependent Inverse Temperature",
      "description": "The inverse temperature applied to the Q-values changes depending on whether the previous trial was rewarded or unrewarded.",
      "params": [
        {
          "name": "beta_loss",
          "bounds": [
            0,
            10
          ]
        }
      ],
      "slots": {
        "init": "outcome_dependent_temperature_last_r = 0.0",
        "post_trial": "if a1 != -1:\n    outcome_dependent_temperature_last_r = r"
      },
      "overrides": {
        "stage1_temp": "beta if outcome_dependent_temperature_last_r == 1.0 else beta_loss",
        "stage2_temp": "beta if outcome_dependent_temperature_last_r == 1.0 else beta_loss"
      },
      "provenance": [
        "13"
      ],
      "excludes": [
        "independent_betas",
        "separate_stage_betas"
      ]
    },
    {
      "id": "pure_model_free",
      "name": "Pure Model-Free",
      "description": "Uses only model-free Q-values for Stage 1 decisions, ignoring model-based calculations.",
      "params": [],
      "slots": {},
      "overrides": {
        "stage1_values": "q_stage1_mf"
      },
