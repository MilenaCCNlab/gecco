      "id": "separate_stage_betas",
      "name": "Separate Stage Betas",
      "description": "Uses distinct inverse temperature parameters for Stage 1 and Stage 2.",
      "params": [
        {
          "name": "beta_2",
          "bounds": [
            0,
            10
          ]
        }
      ],
      "slots": {},
      "overrides": {
        "stage2_temp": "beta_2"
      },
      "provenance": [
