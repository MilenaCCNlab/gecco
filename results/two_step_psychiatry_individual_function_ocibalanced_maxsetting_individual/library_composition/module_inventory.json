      ]
    },
    {
      "id": "stage2_unchosen_value_decay",
      "name": "Stage 2 Unchosen Value Decay",
      "description": "Only the values of unchosen actions in Stage 2 decay towards zero.",
      "params": [
        {
          "name": "decay_rate_stage2",
          "bounds": [
            0,
            1
          ]
        }
      ],
      "slots": {
        "post_trial": "if s_idx != -1 and a2 != -1:\n    q_stage2_mf[s_idx, 1 - a2] *= (1.0 - decay_rate_stage2)\n    q_stage2_mf[1 - s_idx, :] *= (1.0 - decay_rate_stage2)"
      },
      "overrides": {},
      "provenance": [
        "10"
      ],
      "excludes": [
        "unchosen_value_decay",
        "unchosen_value_decay_center",
        "stage2_value_decay_center"
      ]
    },
    {
      "id": "stage2_first_update",
      "name": "Stage 2 First Update",
      "description": "Updates the Stage 2 Q-value before computing the Stage 1 TD error, so the Stage 1 update uses the newly updated Stage 2 value.",
      "params": [],
      "slots": {
        "update_extra": "q_stage1_mf[a1] += learning_rate * (q_stage2_mf[s_idx, a2] - q_stage1_mf[a1])"
      },
      "overrides": {
        "stage1_update": "pass"
      },
      "provenance": [
        "13"
      ],
      "excludes": [
        "direct_stage1_reward_update",
        "eligibility_trace"
      ]
    }
